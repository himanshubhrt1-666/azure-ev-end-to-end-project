{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-datalake-dev8"
		},
		"ls_adls_gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_gen2'"
		},
		"ls_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stadlsdev008.dfs.core.windows.net/"
		},
		"ls_voltgrid_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ev-project-navy-mu.vercel.app/"
		},
		"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_run_date": {
			"type": "string",
			"defaultValue": "@{formatDateTime(trigger().scheduledTime, 'yyyy-MM-dd')}"
		},
		"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_username": {
			"type": "string",
			"defaultValue": "himan_volt"
		},
		"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_password": {
			"type": "string",
			"defaultValue": "himan@volt1"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-datalake-dev8_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_gen2_accountKey": {
						"value": "[parameters('ls_adls_gen2_accountKey')]"
					},
					"ls_adls_gen2_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_gen2_properties_typeProperties_url')]"
					},
					"ls_voltgrid_api_properties_typeProperties_url": {
						"value": "[parameters('ls_voltgrid_api_properties_typeProperties_url')]"
					},
					"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_run_date": {
						"value": "[parameters('trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_run_date')]"
					},
					"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_username": {
						"value": "[parameters('trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_username')]"
					},
					"trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_password": {
						"value": "[parameters('trg_daily_payments_properties_pl_ingest_voltgrid_payments_to_bronze_parameters_api_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}