{
	"name": "pl_day5_demo",
	"properties": {
		"activities": [
			{
				"name": "act_lookup_tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_tables_config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "act_set_all_tables",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_all_tables",
					"value": [
						"@activity('act_lookup_tables').output.value"
					]
				}
			},
			{
				"name": "var_table_count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_table_count",
					"value": {
						"value": "@activity('act_lookup_tables').output.count",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_filter_active",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('act_lookup_tables').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().active,true)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_env": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"variables": {
			"var_all_tables": {
				"type": "Array",
				"defaultValue": []
			},
			"var_table_count": {
				"type": "Integer"
			},
			"v_schema": {
				"type": "String"
			}
		},
		"annotations": []
	}
}