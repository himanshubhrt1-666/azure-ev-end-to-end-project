{
	"name": "pl_day5_demo",
	"properties": {
		"activities": [
			{
				"name": "act_lookup_tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_tables_config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "act_set_all_tables",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_all_tables",
					"value": [
						"@activity('act_lookup_tables').output.value"
					]
				}
			},
			{
				"name": "var_table_count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_table_count",
					"value": {
						"value": "@activity('act_lookup_tables').output.count",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_filter_active",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "act_lookup_tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('act_lookup_tables').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().active,true)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_route_env",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "act_filter_active",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.p_env",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "dev",
							"activities": [
								{
									"name": "act_set_dev_schema",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_schema",
										"value": "stg"
									}
								}
							]
						},
						{
							"value": "prod",
							"activities": [
								{
									"name": "act_set_prod_schema",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "v_schema",
										"value": "dbo"
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "act_fail_bad_env",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Unkown Environment',pipeline().parameters.p_env)",
									"type": "Expression"
								},
								"errorCode": "BAD_ENV"
							}
						}
					]
				}
			},
			{
				"name": "act_loop_tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "act_route_env",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('act_filter_active').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "act_track_table",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_last_table",
								"value": {
									"value": "@item().table",
									"type": "Expression"
								}
							}
						},
						{
							"name": "act_pause",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "act_track_table",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 3
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_env": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"variables": {
			"var_all_tables": {
				"type": "Array",
				"defaultValue": []
			},
			"var_table_count": {
				"type": "Integer"
			},
			"v_schema": {
				"type": "String"
			},
			"v_last_table": {
				"type": "String"
			}
		},
		"annotations": []
	}
}